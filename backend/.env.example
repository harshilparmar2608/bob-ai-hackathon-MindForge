# =============================================================================
# CampusPilot Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# =============================================================================

# Application
APP_NAME=CampusPilot
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
RELOAD=true

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Database — development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./campuspilot.db
DATABASE_ECHO=false

# Database — production (PostgreSQL) example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/campuspilot
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_PRE_PING=true

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_PRE_PING=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# IBM Granite (future integration)
GRANITE_API_URL=
GRANITE_API_KEY=
GRANITE_MODEL_ID=
GRANITE_TIMEOUT_SECONDS=60
GRANITE_ENABLED=false

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
